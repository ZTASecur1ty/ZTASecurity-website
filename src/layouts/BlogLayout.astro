---
import AppLayout from "@layouts/AppLayout.astro";
import Pagination from "@components/Pagination.astro";
import Logo from "@components/Logo.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { author } from "@data/socials";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  pubDate: Date;
  url: string;
  updatedDate: Date | undefined;
  tags: string[];
}

const { title, description, image, imageAlt, pubDate, url, updatedDate, tags } =
  Astro.props;

const ogImage = {
  src: `/image/${url}.png`,
  alt: title,
};

const fullPubDate = pubDate.toLocaleDateString("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<AppLayout
  title={`${title} — ZTA Security`}
  description={description}
  ogImage={ogImage}
  pubDate={updatedDate ?? pubDate}
  tags={tags}
>
  <div class="mx-auto max-w-3xl px-6 pt-16">
    <a
      href="/blog/"
      class="text-sm text-ink-500 transition-colors hover:text-ink"
    >
      &larr; Blog
    </a>
    <header class="mb-10 mt-8">
      <h1
        class="font-serif text-3xl font-medium leading-tight tracking-tight sm:text-5xl"
      >
        {title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-500">{description}</p>
      <div
        class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-line pt-6 text-sm text-ink-500"
      >
        <Logo wordmark={false} class="[&>svg]:h-5" />
        <span class="font-medium text-ink">{author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{fullPubDate}</time>
      </div>
    </header>
    <Image
      src={image}
      alt={imageAlt}
      loading="eager"
      class="mb-12 w-full rounded-xl border border-line"
      width={1200}
      height={630}
    />
    <article class="prose prose-lg max-w-none prose-hr:my-10 prose-img:rounded-xl">
      <slot />
    </article>
    {
      tags.length > 0 && (
        <ul class="mt-12 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full border border-line px-3 py-1 text-xs text-ink-500">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
    <Pagination />
  </div>
</AppLayout>
