---
import AppLayout from "@layouts/AppLayout.astro";
import PostList from "@components/PostList.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = "Blog — ZTA Security";
const description =
  "Articles on cybersecurity, software development, and the products we build.";
---

<AppLayout title={title} description={description}>
  <div class="mx-auto max-w-5xl px-6 pt-20">
    <h1 class="font-serif text-4xl font-medium tracking-tight sm:text-5xl">
      Blog
    </h1>
    <p class="mb-12 mt-4 max-w-2xl text-lg leading-relaxed text-ink-500">
      {description}
    </p>
    <PostList posts={posts} />
  </div>
</AppLayout>
