---
import AppLayout from "@layouts/AppLayout.astro";
import PostList from "@components/PostList.astro";
import { email, safeBrowsingUrl } from "@data/socials";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const services = [
  {
    title: "Security training",
    body: "Practical training for engineers on secure design, secure code, and the threats that target modern development environments.",
  },
  {
    title: "Compliance frameworks",
    body: "Controls and processes mapped to your development workflow, so meeting security standards becomes part of how you ship.",
  },
  {
    title: "Zero-trust implementation",
    body: "Hands-on help to design and roll out zero-trust architecture across your infrastructure, tooling, and pipelines.",
  },
];

const features = [
  {
    title: "Smart detection",
    body: "Warns you when a page shows signs of phishing or suspicious behavior.",
  },
  {
    title: "Minimal alerts",
    body: "Clear, unobtrusive indicators instead of a flood of pop-ups.",
  },
  {
    title: "Quick actions",
    body: "Go back safely, copy a URL for review, or verify a site with a search.",
  },
  {
    title: "Privacy first",
    body: "No data is sold or sent to third parties.",
  },
];
---

<AppLayout title="ZTA Security — Cybersecurity for development teams">
  <section class="mx-auto max-w-5xl px-6 pb-20 pt-20 sm:pt-28">
    <p class="mb-6 text-sm font-medium text-ink-500">
      Non-profit cybersecurity
    </p>
    <h1
      class="max-w-3xl font-serif text-4xl font-medium leading-[1.1] tracking-tight sm:text-6xl"
    >
      Security for the teams who build software.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-700">
      ZTA Security helps software engineering teams secure modern development
      environments with training, compliance frameworks, and zero-trust
      implementation that fit into the way you already work.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={`mailto:${email}`}
        class="rounded-full bg-brand px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-brand-700"
      >
        Get in touch
      </a>
      <a
        href="/blog/"
        class="rounded-full border border-line-strong px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-paper-200"
      >
        Read the blog
      </a>
    </div>
  </section>

  <section id="services" class="border-t border-line">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid gap-12 lg:grid-cols-3">
        <div>
          <h2 class="font-serif text-3xl font-medium tracking-tight">
            What we do
          </h2>
          <p class="mt-4 leading-relaxed text-ink-500">
            Security work that integrates with your development lifecycle, so
            you protect critical assets without slowing down delivery.
          </p>
        </div>
        <ul class="grid gap-px overflow-hidden rounded-xl border border-line bg-line lg:col-span-2">
          {
            services.map((service) => (
              <li class="bg-paper-50 p-6 sm:p-8">
                <h3 class="font-medium">{service.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-500">
                  {service.body}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="safe-browsing" class="border-t border-line">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <p class="mb-3 text-sm font-medium text-ink-500">Product</p>
          <h2 class="font-serif text-3xl font-medium tracking-tight">
            Safe Browsing
          </h2>
          <p class="mt-4 max-w-md leading-relaxed text-ink-700">
            A lightweight Chrome extension that helps you spot risky websites
            and browse with confidence.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={safeBrowsingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full bg-brand px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-brand-700"
            >
              Add to Chrome
            </a>
            <a
              href="/blog/safe-browsing-extension/"
              class="rounded-full border border-line-strong px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-paper-200"
            >
              Read the announcement
            </a>
          </div>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {
            features.map((feature) => (
              <li class="rounded-xl border border-line bg-paper-50 p-6">
                <h3 class="font-medium">{feature.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-500">
                  {feature.body}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="border-t border-line">
        <div class="mx-auto max-w-5xl px-6 py-20">
          <div class="mb-8 flex items-baseline justify-between gap-4">
            <h2 class="font-serif text-3xl font-medium tracking-tight">
              From the blog
            </h2>
            <a
              href="/blog/"
              class="text-sm text-ink-500 transition-colors hover:text-ink"
            >
              All posts &rarr;
            </a>
          </div>
          <PostList posts={posts} />
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-6">
    <div
      class="flex flex-col items-start justify-between gap-6 rounded-2xl bg-paper-200 px-8 py-12 sm:flex-row sm:items-center sm:px-12"
    >
      <div>
        <h2 class="font-serif text-2xl font-medium tracking-tight sm:text-3xl">
          Secure your development environment.
        </h2>
        <p class="mt-2 text-ink-500">
          Tell us about your team and what you are building.
        </p>
      </div>
      <a
        href={`mailto:${email}`}
        class="shrink-0 rounded-full bg-brand px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-brand-700"
      >
        Contact us
      </a>
    </div>
  </section>
</AppLayout>
