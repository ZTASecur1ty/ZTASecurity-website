---
import { Icon } from "astro-icon";
import Logo from "@components/Logo.astro";
import { email, socials } from "@data/socials";

const year = new Date().getFullYear();

const links = [
  { href: "/blog/", text: "Blog" },
  { href: "/privacy_policy/", text: "Privacy Policy" },
  { href: `mailto:${email}`, text: email },
];

const icons = [
  { href: socials.github, label: "GitHub", icon: "mdi:github" },
  { href: socials.linkedin, label: "LinkedIn", icon: "mdi:linkedin" },
];
---

<footer class="mt-24 border-t border-line">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-10 sm:flex-row sm:items-start sm:justify-between"
  >
    <div class="space-y-3">
      <a href="/" aria-label="ZTA Security home"><Logo /></a>
      <p class="text-sm text-ink-500">
        &copy; 2021&ndash;{year} ZTA Security. All rights reserved.
      </p>
    </div>
    <div class="flex flex-col gap-4 sm:items-end">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-ink-500 transition-colors hover:text-ink"
              >
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="flex gap-4">
        {
          icons.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-ink-500 transition-colors hover:text-ink"
                aria-label={item.label}
                title={item.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name={item.icon} class="h-5 w-5" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
