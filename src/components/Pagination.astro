---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);

const index = posts.findIndex((post) => {
  return Astro.request.url.includes(post.slug);
});

const nextPost = posts[index + 1];
const prevPost = posts[index - 1];
const linkClass =
  "group flex flex-1 flex-col rounded-xl border border-line bg-paper-50 p-5 text-sm transition-colors hover:border-line-strong";
---

{
  (prevPost || nextPost) && (
    <nav class="mt-16 flex w-full flex-col gap-4 sm:flex-row" aria-label="More posts">
      {prevPost && (
        <a href={`/blog/${prevPost.slug}/`} class={linkClass}>
          <span class="mb-1 text-ink-500">&larr; Previous</span>
          <span class="font-medium text-ink">{prevPost.data.title}</span>
        </a>
      )}
      {nextPost && (
        <a href={`/blog/${nextPost.slug}/`} class={`${linkClass} text-right`}>
          <span class="mb-1 text-ink-500">Next &rarr;</span>
          <span class="font-medium text-ink">{nextPost.data.title}</span>
        </a>
      )}
    </nav>
  )
}
